{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["notebooks/AGENTS.md"],
  "permission": {
    "bash": {
      "*": "ask",
      ".venv/bin/python -m app*": "allow",
      "../.venv/bin/python -m app*": "allow",
      ".venv/bin/python -m json.tool *": "allow",
      "../.venv/bin/python -m json.tool *": "allow",
      ".venv/bin/pylint *": "allow",
      "../.venv/bin/pylint *": "allow",
      "grep *": "allow",
      "sed -n *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "ls *": "allow",
      "file *": "allow",
      ".venv/bin/pip *": "ask",
      "*uv pip *": "ask"
    },
    "edit": {
      "*": "allow",
      "*report/Отчёт.tex": "ask",
      "*docs/notes/methods.md": "ask"
    },
    "task": {
      "*": "allow",
      "reviewer": "ask"
    }
  }
}
